Thumbs.db

# Restricted data: the records that produce the results but cannot be published
# (original survey exports, pseudonym maps, team spreadsheets with copyrighted item texts or
# free-text answers). One folder per phase; only its MANIFEST.csv and README.md are committed.
**/restricted-data/*
!**/restricted-data/MANIFEST.csv
!**/restricted-data/README.md

# Older locations of personal data and scratch files (kept ignored for safety).
**/data/private/
**/data/private.*
**/data/private-*
**/tmp-data/

# Local working folders (not versioned). The scripts that read
# Gdrive_files/ (ignored above by *_files/) use it only for optional checks.
Data_Analysis/
phase2-2-itemreduction/
.here
git_status_claude.txt
